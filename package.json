{
  "name": "mythic-plus-tips",
  "private": true,
  "scripts": {
    "build": "npm run build:icons && npm run build:css && npm run build:sw",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./css/tailwind.css --minify",
    "build:sw": "node tools/build-sw.js",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./css/tailwind.css --watch",
    "sync:wowhead": "NODE_USE_ENV_PROXY=1 node --no-warnings tools/wowhead-sync.js",
    "build:icons": "python3 tools/build-icons.py",
    "validate": "node tools/validate-data.js",
    "test": "node tests/smoke.mjs",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.0"
  }
}
